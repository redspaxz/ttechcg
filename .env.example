APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8080
APP_TIMEZONE=Africa/Douala
CONTACT_EMAIL=info@ttechcg.com
CONTACT_FROM_EMAIL=website@ttechcg.com
RUN_MIGRATIONS=true

PICKUPSHEET_RBAC_USERS=records-admin|admin|Records|Administrator|replace-with-password-hash

# JumpCloud OIDC SSO. Keep disabled until the client ID, one-time client secret,
# callback URI, group claim, and all three role groups are configured.
JUMPCLOUD_OIDC_ENABLED=false
JUMPCLOUD_OIDC_ISSUER=https://oauth.id.jumpcloud.com/
JUMPCLOUD_OIDC_CLIENT_ID=
JUMPCLOUD_OIDC_CLIENT_SECRET=
JUMPCLOUD_OIDC_REDIRECT_URI=https://ttechcg.com/dhl/pickupsheet/auth/jumpcloud/callback
JUMPCLOUD_OIDC_GROUPS_CLAIM=groups
JUMPCLOUD_OIDC_CLIENT_AUTHENTICATION=client_secret_basic
JUMPCLOUD_RBAC_ADMIN_GROUP=Pickupsheet Admins
JUMPCLOUD_RBAC_OPERATOR_GROUP=Pickupsheet Operators
JUMPCLOUD_RBAC_VIEWER_GROUP=Pickupsheet Viewers

# Optional Cloudflare Access handoff. When the Pickupsheet path is protected by
# Access using JumpCloud, a verified Access session skips the application login.
CLOUDFLARE_ACCESS_ENABLED=false
CLOUDFLARE_ACCESS_TEAM_DOMAIN=https://ttechconsultgroup.cloudflareaccess.com
CLOUDFLARE_ACCESS_AUDIENCE=e7ab5db07a198e02d5289701a019a815c1988bb228a1009e04df5c411dc58267
CLOUDFLARE_ACCESS_GROUPS_CLAIM=groups

# Restrict only Pickupsheet routes by Cloudflare's CF-IPCountry header.
# Production enables this by default; non-production environments ignore it.
PICKUPSHEET_GEO_RESTRICTION_ENABLED=true
PICKUPSHEET_ALLOWED_COUNTRIES=CM,NG
# Legacy single-admin credentials remain supported during migration.
PICKUPSHEET_RECORDS_USER=
PICKUPSHEET_RECORDS_PASSWORD_HASH=
PICKUPSHEET_RECORDS_FIRST_NAME=
PICKUPSHEET_RECORDS_LAST_NAME=

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=ttecwymc_PS1
DB_USER=ttecwymc_tt231
DB_PASSWORD=replace-with-server-password
